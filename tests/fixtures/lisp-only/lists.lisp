(defun squares (n)
  (loop for i from 1 to n collect (* i i)))

(defun make-counter ()
  (let ((n 0))
    (lambda () (incf n))))

(defvar *depth* 1)

(defun show-depth () *depth*)

(print (squares 5))
(print (mapcar #'1+ '(1 2 3)))
(print (reduce #'+ (squares 10)))
(let ((stack nil))
  (push 1 stack)
  (push 2 stack)
  (print (pop stack))
  (print stack))
(print (assoc 'b '((a . 1) (b . 2))))
(print (loop for x in '(3 1 4 1 5) maximize x))
(print (reverse '(1 2 3)))
(print (append '(1 2) '(3)))
(let ((counter (make-counter)))
  (funcall counter)
  (print (funcall counter)))
(print (list 1 "two" #\3 'four))
(print (let ((*depth* 2)) (show-depth)))
(print (show-depth))
(print (equal '(1 (2)) '(1 (2))))
(print (loop for i below 10 when (evenp i) sum i))
(print (mapcar (lambda (x) (* x 10)) '(1 2 3)))
