(setq a 0)
(setq b 5)
(setq c 2)
(setq d 0)
(setq e 0)
(setq vector1 (make-array 100 :initial-element 0))

(defun my_func ()
  (let* ((f 5))
    (loop while (/= e f) do
      (format t "The value of e is:~%")
      (format t "~d" e)
      (incf e))
    e))

(defun new_func (a b c)
  (when (>= a b)
    (if (>= a c)
        (return-from new_func a)
        (return-from new_func c)))
  b)

(defun main ()
  (let* ((g 0)
         (i 0)
         (vector2 (make-array 100 :initial-element 0))
         (h 0))
    (format t "Hello world!~%")
    (setf a b)
    (setf d (truncate (* b c) 10))
    (format t "~d" d)
    (my_func)
    (when (= e b) (format t "Variable 'e' equals 'b'~%"))
    (setf g (* (+ (truncate (+ 5 (* 3 5)) 2) 5) -1))
    (format t "~d" g)
    (if (< e g)
        (format t "Variable 'e' is less than 'g'~%")
        (format t "Variable 'e' is greater than or equal to 'g'~%"))
    (format t "Counting up with i:~%")
    (setf i 0)
    (loop while (< i 15) do
      (format t "~d" i)
      (incf i))
    (setf (aref vector1 50) 5)
    (setf (aref vector2 50) 5)
    (setf a (+ (aref vector1 50) (aref vector2 50)))
    (format t "~%")
    (format t "~d" a)
    (setf h (new_func 12 11 10))
    (format t "~%")
    (format t "~d" h)))

(main)
